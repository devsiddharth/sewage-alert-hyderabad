# Base URL of the Spring Cloud Gateway.
# Leave unset in development: Vite proxies /api -> http://localhost:8080 automatically.
# Set this when the frontend is served separately from the gateway (e.g. deployed build).
# VITE_API_URL=http://localhost:8080

# Override the Vite dev proxy target (default: http://localhost:8080).
# VITE_PROXY_TARGET=http://localhost:8080
