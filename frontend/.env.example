[TEMPLATE]
# Development only — leave VITE_API_URL UNSET in production.
#
# Dev: Vite proxies /api -> http://localhost:8080 automatically, so nothing
#      needs to be set here.
#
# Prod (Vercel): the deployed frontend proxies /api -> the EC2 gateway via
#      frontend/vercel.json, so the browser never calls the gateway directly.
#      Do NOT set VITE_API_URL=http://16.113.76.178:8080 in the Vercel
#      environment — it would produce mixed-content requests. Leave it unset.
# VITE_API_URL=http://localhost:8080

# Override the Vite dev proxy target (default: http://localhost:8080).
# VITE_PROXY_TARGET=http://localhost:8080
