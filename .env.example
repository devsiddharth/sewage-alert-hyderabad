# ─────────────────────────────────────────────────────────────────────────────
# Sewage Alert Hyderabad — environment variable reference
#
# Copy to a local (git-ignored) .env.local / set in your shell or IDE run config.
# NEVER commit real secrets — the private keys below are intentionally blank.
# ─────────────────────────────────────────────────────────────────────────────

# ── EmailJS (Notification Service) ──────────────────────────────────────────
# Used by the Notification Service to send transactional emails (verification,
# welcome, and future complaint updates) via the EmailJS REST API.
EMAILJS_SERVICE_ID=service_2mr35tu
EMAILJS_TEMPLATE_ID=template_w4koj8i
EMAILJS_PUBLIC_KEY=MyulJdGHUa8l4HGfp
# EmailJS PRIVATE KEY — required for server-side sends. Set it in your local
# environment only (see notification-service/.env.local as a git-ignored template).
EMAILJS_PRIVATE_KEY=
# Optional: separate template id for the post-verification welcome email.
# When blank, no welcome email is sent. Template is created in the EmailJS
# dashboard — see notification-service/EMAILJS-WELCOME-TEMPLATE.md.
EMAILJS_WELCOME_TEMPLATE_ID=template_4zjeir8

# ── Frontend origin ──────────────────────────────────────────────────────────
# Public origin of the React app — used to build the verification link in emails.
#   Dev:        http://localhost:5173
#   Production: https://your-production-domain.com
FRONTEND_URL=http://localhost:5173

# ── Email verification token (Auth Service) ─────────────────────────────────
# Lifetime of the verification link in minutes (default 30).
VERIFICATION_TOKEN_TTL_MINUTES=30

# ── RabbitMQ (all services) ─────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
