<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent: Inherits Spring Boot and Cloud dependency management from the root project -->
    <parent>
        <groupId>com.sewagealert</groupId>
        <artifactId>sewage-alert-hyderabad</artifactId>
        <version>1.0.0</version>
    </parent>

    <!-- notification-service: Consumes domain events from RabbitMQ and stores/retrieves user notifications.
         Fully event-driven — no other service ever writes directly to the notification database. -->
    <artifactId>notification-service</artifactId>
    <name>Notification Service</name>
    <description>Event-driven Notification Service for Sewage Alert Hyderabad</description>

    <dependencies>
        <!-- Spring Boot Web: Provides REST APIs for retrieving notifications -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: ORM for persisting notifications in MySQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation: Jakarta Bean Validation for request DTO validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring AMQP: RabbitMQ producer/consumer integration (topic exchange, DLQ, retries) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Eureka Client: Registers this service with the Eureka Discovery Server -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- OpenFeign: Declarative REST client for inter-service communication (User Service).
             Currently dormant — used by future delivery channels (email/SMS/push) to fetch
             user contact details when delivering notifications outside the in-app inbox. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Lombok: Reduces boilerplate (@RequiredArgsConstructor, @Slf4j, DTO annotations) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>compile</scope>
        </dependency>

        <!-- MySQL Connector: Production database driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2: In-memory database for development and testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test: JUnit 5, Mockito and AssertJ for the email/notification service tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: starts a REAL RabbitMQ broker for the end-to-end notification
             pipeline integration test (NotificationRabbitMqIntegrationTest). @ServiceConnection
             wires the container's broker into the Spring context automatically. The test is
             skipped (not failed) when no Testcontainers-compatible Docker daemon is reachable
             — see @Testcontainers(disabledWithoutDocker = true) in the test class. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Swagger/OpenAPI: Springdoc UI + API docs (MVC stack) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.17</version>
        </dependency>
    </dependencies>

</project>
