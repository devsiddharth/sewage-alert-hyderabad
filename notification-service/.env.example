# Copy this file to `notification-service/.env.local` and fill in your real values.
# .env.local is git-ignored — never commit real credentials.

# ── EmailJS (required for verification / welcome emails to be sent) ──────────
# From https://dashboard.emailjs.com → Account / Email Services / Email Templates.
# IMPORTANT: the Email Service must be ACTIVATED — EmailJS emails you an activation
# link at the service's "From Email" address; until you click it, sends fail with
# "domain not verified" and the customer never receives the email.
EMAILJS_SERVICE_ID=service_xxxxxxxxxxx
EMAILJS_TEMPLATE_ID=template_w4koj8i
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
# Optional: separate welcome-email template (post-verification).
EMAILJS_WELCOME_TEMPLATE_ID=template_4zjeir8

# ── Frontend origin — used to build the verification link in the email ───────
FRONTEND_URL=http://localhost:5173

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# The auth service must publish USER_REGISTERED / EMAIL_VERIFICATION_REQUESTED
# events onto `notification.exchange` for the verification email to be sent at all.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── MySQL (this service's database) ──────────────────────────────────────────
# The JDBC URL / credentials are configured directly in
# notification-service/src/main/resources/application.yml — create the database
# first: CREATE DATABASE sewagealert_notifications;
